# Convert to LF line endings on checkout.
*.sh text eol=lf

# Generated files: collapsed in GitHub diffs/PRs, hidden from blame, and left out
# of the language stats. Review the generator input, not these.
# mwrap `make mex` output from matlab/{cu,}finufft.mw:
matlab/finufft.cpp      linguist-generated=true
matlab/cufinufft.cu     linguist-generated=true
matlab/finufft_plan.m   linguist-generated=true
matlab/cufinufft_plan.m linguist-generated=true
# docs/makecdocs.sh (from docs/*.docsrc), docs/genmatlabhelp.sh (from matlab/*.m),
# and `make --no-print-directory > docs/makefile.doc`; every docs/*.doc is generated:
docs/*.doc              linguist-generated=true
