# Build/test/wheel image for cufinufft, parameterized by CUDA version.
#
# manylinux_2_28 is AlmaLinux 8, so NVIDIA's rhel8 packages install natively and
# auditwheel can produce manylinux_2_28 wheels from the image the tests run in.
# Both tags are pinned so a CI failure is attributable.
FROM quay.io/pypa/manylinux_2_28_x86_64:2026.08.04-1

# GCC_TOOLSET must name a host compiler this nvcc accepts (<=11 for CUDA 11.x,
# <=13 for CUDA 12.x, <=14 for CUDA 13.x); the image's default gcc is newer.
ARG CUDA_VERSION=12.4
ARG GCC_TOOLSET=13

# cufinufft needs only nvcc, cudart and cuFFT. The rest are for the test venv:
# pycuda compiles against the profiler API and curand headers and links the
# libcuda stub from cuda-driver-devel, cupy-cuda11x loads the system libnvrtc.
RUN cuda_dash=$(echo ${CUDA_VERSION} | tr . -) && \
    yum install -y yum-utils gcc-toolset-${GCC_TOOLSET} && \
    yum-config-manager --add-repo https://developer.download.nvidia.com/compute/cuda/repos/rhel8/x86_64/cuda-rhel8.repo && \
    yum install -y \
        cuda-nvcc-${cuda_dash} \
        cuda-cudart-devel-${cuda_dash} \
        libcufft-devel-${cuda_dash} \
        cuda-compat-${cuda_dash} \
        cuda-profiler-api-${cuda_dash} \
        libcurand-devel-${cuda_dash} \
        cuda-driver-devel-${cuda_dash} \
        cuda-nvrtc-${cuda_dash} && \
    ln -s cuda-${CUDA_VERSION} /usr/local/cuda && \
    yum clean all && rm -rf /var/cache/yum/*

ENV CUDA_HOME=/usr/local/cuda
ENV PATH=/opt/rh/gcc-toolset-${GCC_TOOLSET}/root/usr/bin:/usr/local/cuda/bin:${PATH}
# cuda-compat is installed but deliberately kept off LD_LIBRARY_PATH: forcing its
# libcuda gives cudaErrorSystemDriverMismatch on hosts with a newer driver. The
# container runtime picks it up when the host driver is older.
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64
# The real libcuda.so.1 only appears at runtime, injected by the runtime.
ENV LIBRARY_PATH=/usr/local/cuda/lib64/stubs

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Default python3 for the build scripts; cmake/ninja are not in the base image.
RUN ln -s /opt/python/cp312-cp312/bin/python3 /usr/local/bin/python3 && \
    python3 -m pip install --no-cache-dir --upgrade pip auditwheel cmake ninja

# The GPU frameworks the Python tests run against, baked in: ~3GB of downloads
# per CI run otherwise. TORCH_INDEX must be a CUDA version PyTorch ships wheels
# for (cu118, cu124, cu126, cu128, cu130 - there is no cu133, for instance).
ARG TORCH_INDEX=cu124
RUN python3 -m pip install --no-cache-dir pytest pytest-mock numba pycuda \
        "cupy-cuda${CUDA_VERSION%%.*}x" && \
    python3 -m pip install --no-cache-dir torch \
        --index-url https://download.pytorch.org/whl/${TORCH_INDEX}

CMD ["/bin/bash"]
