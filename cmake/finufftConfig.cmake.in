@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Re-discover the dependencies that the exported targets reference. For a SHARED
# build everything is baked into the library, so only the (interface-propagated)
# OpenMP runtime needs to be found. For a STATIC build the FFT backend and its
# threading runtime are separate archives that the consumer must also link.
if(@FINUFFT_USE_OPENMP@)
    find_dependency(OpenMP COMPONENTS C CXX)
endif()

if(@FINUFFT_STATIC_LINKING@ AND @FINUFFT_USE_DUCC0@)
    # DUCC0 is bundled by FINUFFT and exported alongside it (as finufft::ducc0).
    # It only needs a threading runtime when OpenMP is not used.
    if(NOT @FINUFFT_USE_OPENMP@)
        find_dependency(Threads)
    endif()
endif()

# A STATIC build against a *system* FFTW exports the FFTW::* imported targets by
# name, so they have to exist again here. The install ships the FindFFTW module
# that located them next to this file; its presence is the marker for that case.
# A static build against a downloaded FFTW carries the archives in the export
# instead, and a SHARED build bakes FFTW in, so neither installs the module.
# The NOT TARGET guard matters: FindFFTW creates its imported targets
# unconditionally, so a second run in a consumer that already found FFTW aborts.
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/FindFFTW.cmake" AND NOT TARGET FFTW::Double)
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(FFTW)
    list(POP_FRONT CMAKE_MODULE_PATH)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/finufftTargets.cmake")

check_required_components(finufft)
